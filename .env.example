# Required: Telegram and Remnawave
TELEGRAM_TOKEN=
ADMIN_TELEGRAM_ID=
REMNAWAVE_URL=https://panel.example.com
REMNAWAVE_TOKEN=
REMNAWAVE_MODE=remote
# Secret from the Remnawave panel's WEBHOOK_SECRET_HEADER (32+ characters).
# Required for admin alerts about panel login attempts.
REMNAWAVE_WEBHOOK_SECRET=

# Optional: use this when the Remnawave API is protected by Caddy Security.
# The value is sent to the panel as the X-Api-Key header.
CADDY_AUTH_API_TOKEN=

# Optional additional panel headers: Header-One:value;Header-Two:value
REMNAWAVE_HEADERS=

# eGames Nginx cookie protection. Enter the exact NAME=VALUE pair from nginx.conf.
# Do not include "Cookie:", a login URL, or attributes such as Path=/.
EGAMES_COOKIE=

# Required: database
POSTGRES_USER=linkbot
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=linkbot

# Required: domain. Create an A record to the VPS before starting Caddy.
PUBLIC_HOST=bot.example.com
PUBLIC_BASE_URL=https://bot.example.com
# Необязательно: кабинет на my.bot.example.com. Пусто = кабинет на PUBLIC_HOST.
CABINET_SUBDOMAIN=
# Optional admin DNS label: admin -> https://admin.<PUBLIC_HOST> with the new admin UI; empty keeps the original URL and admin UI.
ADMIN_SUBDOMAIN=

# Required bootstrap value. Referral settings can be changed later in admin UI.
REFERRAL_DAYS=0

# Optional infrastructure settings
GOOGLE_CLIENT_ID=
# Email/password login for the web cabinet. Use your mail provider's SMTP
# credentials (often an app password), never the user's mailbox password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional existing HTTP(S) proxy. It must allow CONNECT to SMTP_HOST:SMTP_PORT.
SMTP_PROXY_URL=
# Optional GA4 site tracking and admin traffic reports. These are separate from Google login.
GA4_MEASUREMENT_ID=
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_FILE=/app/secrets/ga4-service-account.json
# Optional Yandex Metrika tracking and admin reports. OAuth token stays on the server.
YANDEX_METRIKA_COUNTER_ID=
YANDEX_METRIKA_OAUTH_TOKEN=
# Persistent directory for logos uploaded from the Mini App admin panel.
MEDIA_UPLOAD_DIR=/uploads
YOOKASA_PROXY_URL=
REQUIRED_CHANNEL_SUBSCRIPTION_ENABLED=false
REQUIRED_CHANNEL_SUBSCRIPTION_URL=
REQUIRED_CHANNEL_SUBSCRIPTION_TITLE=
DAYS_IN_MONTH=30
IS_WEB_APP_LINK=true
REMNAWAVE_TAG=
WHITELISTED_TELEGRAM_IDS=
REQUIRE_PAID_PURCHASE_FOR_STARS=false
# Global language for the Telegram bot and Mini App: ru, en or fa.
DEFAULT_LANGUAGE=ru
# Display font: auto (Vazir for fa, Montserrat otherwise), montserrat or vazir.
DEFAULT_FONT=auto
